# Copy to apps/web/.env.local and adjust.

# Leave these unset so the app derives the API/LiveKit URLs from whatever
# hostname and protocol the page was loaded with — that's what makes LAN
# access from a phone work (https://192.168.x.x:3000 → https://192.168.x.x:3002).
# Only set them when those servers live somewhere else.
# NEXT_PUBLIC_API_URL="https://localhost:3002"
# NEXT_PUBLIC_LIVEKIT_URL="wss://localhost:7443"

# The login page's "fill in the demo account" shortcut. Keep in sync with
# DEMO_EMAIL / DEMO_PASSWORD in apps/api/.env, and set
# NEXT_PUBLIC_DEMO_ENABLED=false wherever the demo account is turned off.
NEXT_PUBLIC_DEMO_ENABLED=true
NEXT_PUBLIC_DEMO_EMAIL="demo@example.com"
NEXT_PUBLIC_DEMO_PASSWORD="demo1234"

# Dev server port, and the folder with key.pem + cert.pem for HTTPS
# (defaults to <repo>/certs; point elsewhere to serve plain HTTP).
# PORT=3000
# HTTPS_CERT_DIR=../../certs
