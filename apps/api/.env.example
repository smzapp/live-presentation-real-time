# Copy to apps/api/.env and adjust. Every value below is the default the API
# uses in development; only DATABASE_URL has no fallback.

# ---- Database (PostgreSQL) ----
# Create the database first (psql: CREATE DATABASE livepresentation;), then
# run `npm run db:migrate` in apps/api.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/livepresentation?schema=public"

# ---- Auth ----
# Signs session tokens. Use a long random string anywhere but local dev,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
JWT_SECRET="dev-secret-change-me"

# ---- Super admin ----
# Created on startup if no account with this email exists (an existing
# account is promoted instead). The password is only used when creating the
# account and must be at least 8 characters. Change it after first sign-in.
# Alternatively, promote any existing account: npm run admin:promote -- you@example.com
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="admin1234"

# ---- Demo account ----
# A ready-made account (with sample boards) created on startup, handy for
# trying the app. Keep these in sync with the web app's NEXT_PUBLIC_DEMO_*.
# Set DEMO_ACCOUNT_ENABLED=false in production.
DEMO_ACCOUNT_ENABLED=true
DEMO_EMAIL="demo@example.com"
DEMO_PASSWORD="demo1234"

# ---- Server ----
PORT=3002
# Folder with key.pem + cert.pem to serve HTTPS (needed for camera/mic on
# phones over the LAN). Defaults to <repo>/certs; point it at a folder
# without certs (e.g. "none") to force plain HTTP.
# HTTPS_CERT_DIR=../../certs
# Comma-separated list of allowed browser origins. When unset, localhost and
# private LAN addresses are allowed.
# FRONTEND_ORIGIN="https://app.example.com"

# ---- Live sessions ----
# Days an inactive session is kept in the database before it's deleted.
ROOM_RETENTION_DAYS=7

# ---- LiveKit (video, audio, screen sharing) ----
# Defaults match the local dev server started with `npm run livekit:dev`.
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
LIVEKIT_HTTP_URL="http://127.0.0.1:7880"
# Used by scripts/livekit-dev.mjs:
# LIVEKIT_BIN=vendor/livekit/livekit-server.exe
# LIVEKIT_PLAIN_PORT=7880
# LIVEKIT_TLS_PORT=7443
