generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  // "subscriber" (a regular account, with or without a plan) | "support"
  // (a support agent: answers the chats assigned to them) | "superadmin"
  role         String        @default("subscriber")
  // "active" | "suspended" — suspended users can't sign in and existing
  // sessions stop working immediately.
  status       String        @default("active")
  lastLoginAt  DateTime?
  // Per-user override of what their plan allows in the whiteboard media
  // tool: "plan" (follow the plan) | "full" (library + uploads, no limit) |
  // "none" (no media tool at all).
  mediaAccess  String        @default("plan")
  // When they confirmed their email address (null = not confirmed yet).
  // Accounts created by an admin count as confirmed.
  emailVerifiedAt DateTime?
  createdAt    DateTime      @default(now())
  boards       Board[]
  media        MediaAsset[]
  usage        UsageRecord[]
  supportChats SupportConversation[] @relation("SupportCustomer")
  assignedChats SupportConversation[] @relation("SupportAssignee")
  folders      BoardFolder[]
  subscription Subscription?
  authTokens   AuthToken[]
}

// Single-use links emailed to someone: "verify" (confirm an email address)
// and "reset" (choose a new password). Only the hash of the token is stored,
// so a leaked database still can't be used to take over an account.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "verify" | "reset"
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
  @@index([expiresAt])
}

model Plan {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String         @default("")
  // Display price only — there is no payment provider; admins assign plans.
  priceCents    Int            @default(0)
  // "month" | "year"
  interval      String         @default("month")
  // null = unlimited
  maxBoards     Int?
  // "subscription": a flat price per interval. "payg": nothing up front,
  // charged unitPriceCents for each live session the user hosts.
  billingType     String       @default("subscription")
  unitPriceCents  Int          @default(0)
  // Unlocks the drawing tools an admin marks "paid plans only".
  premiumTools    Boolean      @default(false)
  // Shown as "Most popular" on the subscribe page.
  highlight       Boolean      @default(false)
  // Whiteboard media tool: browse the admin-curated library, upload their
  // own images, and how many uploads they can keep (null = unlimited).
  mediaLibrary    Boolean      @default(true)
  mediaUpload     Boolean      @default(false)
  maxMediaUploads Int?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model Subscription {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId     String
  plan       Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  // "active" | "trialing" | "past_due" | "canceled"
  status     String    @default("active")
  startedAt  DateTime  @default(now())
  renewsAt   DateTime?
  canceledAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([planId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model BoardFolder {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  boards    Board[]

  @@index([ownerId])
}

model Board {
  id        String       @id @default(cuid())
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type      String
  title     String
  data      String
  folderId  String?
  folder    BoardFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId])
  @@index([folderId])
}

// Live session state, written behind the in-memory room (see
// RoomStore) so a session survives an API restart or deploy and a host can
// reconnect and pick up where they left off. Rooms are anonymous (created
// without an account), so there is no owner relation.
model LiveRoom {
  code           String   @id
  title          String
  // The signed-in account that started the session (if any), and whether
  // its plan unlocked paid drawing tools for everyone in the room.
  ownerId        String?
  premiumTools   Boolean  @default(false)
  hostToken      String
  // The passcode guests need to join. It's in the host's invite link
  // (?key=...), and can be typed in by anyone who was told it. Resetting it
  // issues a new one and kills the links already shared.
  joinKey        String   @default("")
  // Whether that passcode is actually enforced; the host can turn it off for
  // a session that anyone with the code may walk into.
  requireKey     Boolean  @default(true)
  // Whether presenting the passcode is enough to be trusted with drawing,
  // screen sharing and the stage. On by default: the link is the host's own
  // invite, so the people who follow it are the people they invited. They
  // can still take any of it back from one person in the participants panel.
  linkGrantsRights Boolean @default(true)
  mode           String   @default("whiteboard")
  slideIndex     Int      @default(0)
  gridVisible    Boolean  @default(true)
  // Stroke[] / Slide[] / ChatMessage[] / Participant[] as JSON.
  strokes        Json     @default("[]")
  slides         Json     @default("[]")
  chat           Json     @default("[]")
  participants   Json     @default("[]")
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  updatedAt      DateTime @updatedAt
  boards         LiveRoomBoard[]

  @@index([lastActivityAt])
}

// One participant's personal board, stored per row so a student drawing on
// their own board only rewrites their strokes, not the whole room.
model LiveRoomBoard {
  roomCode      String
  room          LiveRoom @relation(fields: [roomCode], references: [code], onDelete: Cascade)
  participantId String
  strokes       Json     @default("[]")
  updatedAt     DateTime @updatedAt

  @@id([roomCode, participantId])
}

// Images for the whiteboard media tool. "library" assets are curated by super
// admins and shown to everyone allowed to browse the library; "user" assets
// are someone's own uploads, visible only to them. Stored in the database
// (already downscaled by the client) so there's no file storage to run.
model MediaAsset {
  id        String   @id @default(cuid())
  scope     String
  ownerId   String?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  width     Int
  height    Int
  size      Int
  data      Bytes
  // Small preview for the media grid, so browsing never downloads full images.
  thumb     Bytes
  thumbType String
  createdAt DateTime @default(now())

  @@index([scope, createdAt])
  @@index([ownerId, createdAt])
}

// Metered usage for pay-as-you-go plans: one row per billable event, with
// the price that applied at the time so later price changes don't rewrite
// history.
model UsageRecord {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "session": hosting a live session.
  kind           String
  quantity       Int      @default(1)
  unitPriceCents Int
  // What it was for, e.g. the live session code.
  reference      String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Support chat. One conversation per customer (a signed-in user, or a guest
// identified by the random visitor id their browser keeps), reopened when
// they write again after it was closed.
model SupportConversation {
  id              String           @id @default(cuid())
  userId          String?
  user            User?            @relation("SupportCustomer", fields: [userId], references: [id], onDelete: Cascade)
  guestKey        String?          @unique
  // Shown to staff: the account name, or what a guest typed in.
  customerName    String
  customerEmail   String?
  // "open" | "closed"
  status          String           @default("open")
  // Delegation: the staff member (super admin or support agent) handling it.
  assigneeId      String?
  assignee        User?            @relation("SupportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  unreadForStaff  Int              @default(0)
  unreadForCustomer Int            @default(0)
  lastMessageAt   DateTime         @default(now())
  createdAt       DateTime         @default(now())
  messages        SupportMessage[]

  @@index([userId])
  @@index([assigneeId, lastMessageAt])
  @@index([status, lastMessageAt])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // "customer" | "staff" | "system"
  senderType     String
  senderId       String?
  senderName     String
  body           String
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

// ---- Attendance & participation reporting ----
//
// Live sessions themselves are deleted a week after they go quiet (see
// LiveRoom), but a host's register of who attended has to outlive that — so
// these two tables stand alone, with the session's title and owner copied in
// rather than related.

model SessionLog {
  code           String   @id
  title          String
  // The account that hosted it, if the host was signed in.
  ownerId        String?
  startedAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  // The most people connected at once, for the session summary.
  peakOnline     Int      @default(0)

  @@index([ownerId, startedAt])
}

// One row per person per session, updated as they take part. Written in
// batches (see AttendanceService), never on every stroke.
model SessionAttendance {
  id            String   @id @default(cuid())
  roomCode      String
  participantId String
  name          String
  firstJoinedAt DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  // Time actually connected, summed across reconnects.
  presentMs     Int      @default(0)
  // How many times they connected (a reconnect counts again).
  joins         Int      @default(1)
  // Participation counters.
  strokes       Int      @default(0)
  chatMessages  Int      @default(0)
  handRaises    Int      @default(0)
  reactions     Int      @default(0)
  wasOnStage    Boolean  @default(false)

  @@unique([roomCode, participantId])
  @@index([roomCode])
}
